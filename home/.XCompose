# UTF-8 (Unicode) compose sequence
<Multi_key> <d> <e> <g>: "°" degree # DEGREE SIGN
<Multi_key> <o> <o> : "°" degree # DEGREE SIGN
<Multi_key> <plus> <minus>: "±" # Plus minus

# Quotation marks
<Multi_key> <less> <less>: "«" guillemotleft # LEFT-POINTING DOUBLE ANGLE QUOTATION MARK
<Multi_key> <greater> <greater>: "»" guillemotright # RIGHT-POINTING DOUBLE ANGLE QUOTATION MARK

# Fractions
<Multi_key> <1> <slash> <2>: "½" # Half
<Multi_key> <1> <slash> <3>: "⅓" # Third
<Multi_key> <2> <slash> <3>: "⅔" # Two Thirds
<Multi_key> <1> <slash> <4>: "¼" # Quarter
<Multi_key> <3> <slash> <4>: "¾" #three quarters
<Multi_key> <1> <slash> <5>: "⅕" # Fifth
<Multi_key> <1> <slash> <6>: "⅙" # Sixth
<Multi_key> <1> <slash> <8>: "⅛" # Eighth

# Currencies
<Multi_key> <n> <i> <s>: "₪" # Shekel
<Multi_key> <i> <l> <s>: "₪" # Shekel
<Multi_key> <e> <u> <r>: "€" # Euro
<Multi_key> <y> <e> <n>: "¥" # Yen
<Multi_key> <g> <b> <p>: "£" # Pound Sterling

# Dashes
<Multi_key> <minus> <minus> <space>: "–" U2013 # EN DASH
<Multi_key> <minus> <minus> <minus>: "—" U2014 # EM DASH

# emojis
<Multi_key> <less> <3>: "❤️" # <3
<Multi_key> <plus> <1>: "👍" # THUMBS UP
<Multi_key> <s> <p> <r> <k>: "✨" # SPARKLES
<Multi_key> <s> <t> <a> <r>: "★" # star

# box-drawing
<Multi_key> <b> <d> <f>: "█" # full box
<Multi_key> <b> <d> <l> <7>: "▉" # left 7 box

# kaomoji
<Multi_key> <w> <i> <g> <g>: "〜(꒪꒳꒪)〜"
<Multi_key> <s> <h> <r>:"¯\\_(ツ)_/¯"
<Multi_key> <c> <r> <y>:"｡･ﾟ*(>﹏<)*ﾟ･｡"
<Multi_key> <f> <l> <i> <p>:"(╯° °)╯︵ ┻━┻"
<Multi_key> <u> <n> <f> <l> <i> <p>:"┬──┬◡ﾉ(° -°ﾉ)"
<Multi_key> <f> <l> <o> <p>:"（ノ￣＾￣）ノ　┳┳　┣　┻┻　┫　┳┳"
<Multi_key> <c> <a> <t>:"(˵◝ ⩊  ◜˵マ"
<Multi_key> <k> <a> <t>:"(•˕ •マ.ᐟ"
<Multi_key> <r> <a> <t>:"…ᘛ⁐̤ᕐᐷ"
<Multi_key> <w> <r> <i> <t>:"__φ(。。)"
<Multi_key> <s> <c> <a> <r>:"〣( ºΔº )〣"
<Multi_key> <h> <u> <h>:"¯\\(°_o)/¯"
<Multi_key> <e> <h> <h>:"( º﹃º )"
<Multi_key> <h> <a> <p>:"(≧◡≦)♡"
<Multi_key> <m> <m> <m>:"<(￣︶￣)>"
<Multi_key> <c> <a> <r> <e>:"( ◜‿◝ )♡"
<Multi_key> <s> <a> <d>:"(｡•́︿•̀｡)"
<Multi_key> <k> <a> <t>:"ε٩(๑>◡<)۶з"
<Multi_key> <w> <o> <o>:"＼(°o°)／"
<Multi_key> <d> <a> <n> <c>:"┌(・。・)┘♪"
<Multi_key> <h> <a> <h> <a>:"ꉂ(≧▽≦)"

# Other
<Multi_key> <s> <exclam>: "§" section # SECTION SIGN
<Multi_key> <l> <m>: "λ" # lambda!

